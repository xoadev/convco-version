root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
# Prettier indents a list item's lines under its text (three spaces after `1.`).
indent_size = unset

[*.yml]
indent_size = 2

[*.sh]
indent_size = 2
# shfmt
switch_case_indent = true

[Makefile]
indent_style = tab
